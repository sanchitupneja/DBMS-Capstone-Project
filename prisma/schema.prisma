// ============================================================
// Hostel Room Allocation System — Prisma Schema
// Provider: MySQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum RoomType {
  AC
  NON_AC
}

enum RoomStatus {
  AVAILABLE
  PARTIALLY_OCCUPIED
  FULL
  UNDER_MAINTENANCE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  VACATED
  TRANSFERRED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─────────────────────────────────────────────
// MODEL: Student
// ─────────────────────────────────────────────

model Student {
  id                 String              @id @default(uuid())
  email              String              @unique @db.VarChar(191)
  passwordHash       String              @db.Text
  fullName           String              @db.VarChar(191)
  studentId          String              @unique @db.VarChar(100)
  phone              String?             @db.VarChar(20)
  gender             Gender
  course             String              @db.VarChar(191)
  yearOfStudy        Int
  role               Role                @default(STUDENT)
  profileImageUrl    String?             @db.Text
  isEmailVerified    Boolean             @default(false)
  refreshToken       String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  allocationRequests AllocationRequest[]
  allocations        Allocation[]

  @@index([email])
  @@index([studentId])
  @@map("students")
}

// ─────────────────────────────────────────────
// MODEL: Admin
// ─────────────────────────────────────────────

model Admin {
  id             String   @id @default(uuid())
  email          String   @unique @db.VarChar(191)
  passwordHash   String   @db.Text
  fullName       String   @db.VarChar(191)
  role           Role     @default(ADMIN)
  refreshToken   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  processedRequests AllocationRequest[] @relation("ProcessedBy")
  manualAllocations Allocation[]        @relation("AllocatedBy")

  @@index([email])
  @@map("admins")
}

// ─────────────────────────────────────────────
// MODEL: Hostel
// ─────────────────────────────────────────────

model Hostel {
  id             String     @id @default(uuid())
  name           String     @unique @db.VarChar(191)
  description    String?    @db.Text
  gender         Gender
  address        String     @db.VarChar(300)
  totalRooms     Int        @default(0)
  availableRooms Int        @default(0)
  imageUrl       String?    @db.Text
  // Stored as JSON array: ["WiFi","Gym","Cafeteria"]
  amenities      Json       @default("[]")
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  rooms              Room[]
  allocationRequests AllocationRequest[]

  @@index([gender, isActive])
  @@map("hostels")
}

// ─────────────────────────────────────────────
// MODEL: Room
// ─────────────────────────────────────────────

model Room {
  id            String     @id @default(uuid())
  hostelId      String     @db.VarChar(36)
  roomNumber    String     @db.VarChar(20)
  floor         Int        @default(0)
  roomType      RoomType
  totalBeds     Int
  occupiedBeds  Int        @default(0)
  status        RoomStatus @default(AVAILABLE)
  pricePerMonth Float
  // Stored as JSON array: ["AC","Attached Bathroom"]
  amenities     Json       @default("[]")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  hostel      Hostel     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId, status])
  @@index([hostelId, roomType, status])
  @@index([status])
  @@map("rooms")
}

// ─────────────────────────────────────────────
// MODEL: AllocationRequest
// ─────────────────────────────────────────────

model AllocationRequest {
  id                  String        @id @default(uuid())
  studentId           String        @db.VarChar(36)
  hostelId            String        @db.VarChar(36)
  preferredRoomType   RoomType
  preferredFloor      Int?
  specialRequirements String?       @db.Text
  status              RequestStatus @default(PENDING)
  rejectionReason     String?       @db.Text
  processedById       String?       @db.VarChar(36)
  processedAt         DateTime?
  academicYear        String        @db.VarChar(20)
  semester            Int
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel      Hostel     @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  processedBy Admin?     @relation("ProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  allocation  Allocation?

  @@unique([studentId, academicYear, semester])
  @@index([status, createdAt])
  @@index([hostelId, status])
  @@index([studentId, status])
  @@map("allocation_requests")
}

// ─────────────────────────────────────────────
// MODEL: Allocation
// ─────────────────────────────────────────────

model Allocation {
  id            String           @id @default(uuid())
  studentId     String           @db.VarChar(36)
  roomId        String           @db.VarChar(36)
  requestId     String           @unique @db.VarChar(36)
  allocatedById String?          @db.VarChar(36)
  status        AllocationStatus @default(ACTIVE)
  checkInDate   DateTime
  checkOutDate  DateTime?
  academicYear  String           @db.VarChar(20)
  semester      Int
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  request     AllocationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  allocatedBy Admin?            @relation("AllocatedBy", fields: [allocatedById], references: [id], onDelete: SetNull)

  @@unique([studentId, status, academicYear, semester])
  @@index([roomId, status])
  @@index([studentId, status])
  @@index([academicYear, semester])
  @@map("allocations")
}
