// ============================================================
// Hostel Room Allocation System — Prisma Schema
// Provider: MongoDB (NoSQL). Keep prisma/schema.prisma as the
// single source of truth for the live application.
//
// The original MySQL schema and SQL dumps are preserved under
// sql-reference/ for syllabus comparison — they are not used
// by the application at runtime.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum RoomType {
  AC
  NON_AC
}

enum RoomStatus {
  AVAILABLE
  PARTIALLY_OCCUPIED
  FULL
  UNDER_MAINTENANCE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  VACATED
  TRANSFERRED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─────────────────────────────────────────────
// MODEL: Student  → collection "students"
// ─────────────────────────────────────────────

model Student {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String   @unique
  passwordHash    String
  fullName        String
  studentId       String   @unique
  phone           String?
  gender          Gender
  course          String
  yearOfStudy     Int
  role            Role     @default(STUDENT)
  profileImageUrl String?
  isEmailVerified Boolean  @default(false)
  refreshToken    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allocationRequests AllocationRequest[]
  allocations        Allocation[]

  // @unique on email / studentId already creates the required indexes.
  @@map("students")
}

// ─────────────────────────────────────────────
// MODEL: Admin  → collection "admins"
// ─────────────────────────────────────────────

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(ADMIN)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  processedRequests AllocationRequest[] @relation("ProcessedBy")
  manualAllocations Allocation[]        @relation("AllocatedBy")

  // @unique on email already creates the required index.
  @@map("admins")
}

// ─────────────────────────────────────────────
// MODEL: Hostel  → collection "hostels"
// ─────────────────────────────────────────────

model Hostel {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  description    String?
  gender         Gender
  address        String
  totalRooms     Int      @default(0)
  availableRooms Int      @default(0)
  imageUrl       String?
  // Stored as a BSON array: ["WiFi", "Gym", "Cafeteria"]
  amenities      Json     @default("[]")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rooms              Room[]
  allocationRequests AllocationRequest[]

  @@index([gender, isActive])
  @@map("hostels")
}

// ─────────────────────────────────────────────
// MODEL: Room  → collection "rooms"
// ─────────────────────────────────────────────

model Room {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  hostelId     String     @db.ObjectId
  roomNumber   String
  floor        Int        @default(0)
  roomType     RoomType
  totalBeds    Int
  occupiedBeds Int        @default(0)
  status       RoomStatus @default(AVAILABLE)
  pricePerMonth Float
  // Stored as a BSON array: ["AC", "Attached Bathroom"]
  amenities    Json       @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hostel      Hostel     @relation(fields: [hostelId], references: [id])
  allocations Allocation[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId, status])
  @@index([hostelId, roomType, status])
  @@index([status])
  @@map("rooms")
}

// ─────────────────────────────────────────────
// MODEL: AllocationRequest  → collection "allocation_requests"
// ─────────────────────────────────────────────

model AllocationRequest {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId           String        @db.ObjectId
  hostelId            String        @db.ObjectId
  preferredRoomType   RoomType
  preferredFloor      Int?
  specialRequirements String?
  status              RequestStatus @default(PENDING)
  rejectionReason     String?
  processedById       String?       @db.ObjectId
  processedAt         DateTime?
  academicYear        String
  semester            Int
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  student     Student     @relation(fields: [studentId], references: [id])
  hostel      Hostel      @relation(fields: [hostelId], references: [id])
  processedBy Admin?      @relation("ProcessedBy", fields: [processedById], references: [id])
  allocation  Allocation?

  @@unique([studentId, academicYear, semester])
  @@index([status, createdAt])
  @@index([hostelId, status])
  @@index([studentId, status])
  @@map("allocation_requests")
}

// ─────────────────────────────────────────────
// MODEL: Allocation  → collection "allocations"
// ─────────────────────────────────────────────

model Allocation {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String           @db.ObjectId
  roomId        String           @db.ObjectId
  requestId     String           @unique @db.ObjectId
  allocatedById String?          @db.ObjectId
  status        AllocationStatus @default(ACTIVE)
  checkInDate   DateTime
  checkOutDate  DateTime?
  academicYear  String
  semester      Int
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  student     Student           @relation(fields: [studentId], references: [id])
  room        Room              @relation(fields: [roomId], references: [id])
  request     AllocationRequest @relation(fields: [requestId], references: [id])
  allocatedBy Admin?            @relation("AllocatedBy", fields: [allocatedById], references: [id])

  @@unique([studentId, status, academicYear, semester])
  @@index([roomId, status])
  @@index([studentId, status])
  @@index([academicYear, semester])
  @@map("allocations")
}
